{
  "name": "@gener8v/ui",
  "version": "0.39.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp ../../design/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gener8v/gener8v.designer.design-system.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/gener8v/gener8v.designer.design-system#readme",
  "license": "MIT",
  "author": "GENER8V",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "React components for the GENER8V design system \u2014 the same class names as its static HTML, so markup ports either direction."
}
